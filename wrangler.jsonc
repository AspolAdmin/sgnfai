{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sgnfai",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public" },
  "routes": [
    { "pattern": "sgnf.ai", "custom_domain": true },
    { "pattern": "www.sgnf.ai", "custom_domain": true },
    { "pattern": "sgnfy.ai", "custom_domain": true },
    { "pattern": "www.sgnfy.ai", "custom_domain": true }
  ]
}
